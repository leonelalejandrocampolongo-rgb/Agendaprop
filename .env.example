AUTH_SECRET="replace-with-a-long-random-string"

# Notificaciones por email (opcional). Sin esto, la app funciona igual pero
# no manda emails: solo queda un log en consola.
# 1. Creá una cuenta gratis en https://resend.com
# 2. Generá una API key y pegala acá.
RESEND_API_KEY=""
# Remitente de los emails. Mientras no verifiques tu propio dominio en
# Resend, podés dejar el de pruebas de abajo (solo llega a tu propia cuenta).
RESEND_FROM_EMAIL="AgendaProp <onboarding@resend.dev>"

# Número de WhatsApp del negocio (para el botón "Avisar por WhatsApp" que ve
# la clienta al reservar). Formato internacional, solo números, sin "+" ni
# espacios. Ejemplo Argentina (11 1234-5678): 5491112345678
# Es "NEXT_PUBLIC" a propósito: es el número de contacto del negocio, se
# muestra tal cual en la página pública.
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=""

# --- Solo para producción (Railway u otro hosting) ---
#
# Carpeta donde se guarda data/db.json. En local no hace falta tocarla
# (usa ./data). En producción debe apuntar a un disco persistente (por
# ejemplo, el punto de montaje de un Volume de Railway), sino los turnos
# se borrarían con cada deploy.
DATA_DIR=""

# Si estas dos están definidas, la primera vez que arranca el servidor
# (cuando todavía no existe data/db.json) se crea automáticamente la
# cuenta admin con estas credenciales — así no hace falta abrir una
# terminal en el servidor para correr el seed. En local no son necesarias
# (ya usás `npm run seed`).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
