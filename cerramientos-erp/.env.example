AUTH_SECRET="replace-with-a-long-random-string"

# --- Solo para producción (Railway u otro hosting) ---
#
# Carpeta donde se guarda data/db.json. En local no hace falta tocarla
# (usa ./data). En producción debe apuntar a un disco persistente (por
# ejemplo, el punto de montaje de un Volume de Railway), sino los datos
# se borrarían con cada deploy.
DATA_DIR=""

# Si estas dos están definidas, la primera vez que arranca el servidor
# (cuando todavía no existe data/db.json) se crea automáticamente el
# usuario con estas credenciales. En local podés usar `npm run seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
